# ./install.sh --config install.env 的答案文件：不提问，按这里的值走向导。
# 复制一份再改：cp install.env.example install.env
# 每行 KEY=值；# 开头是注释。这个文件只会被读取，不会被执行。

# demo：只跑离线演示 | real：接自己的微信账号
WES_MODE=demo

# 下面是 real 才用到的：
# 实例名（一个账号一个实例）
#WES_INSTANCE=main
# 只导出这些会话（群名或好友备注，逗号隔开）；不写或留空表示全部
#WES_EXPORT_INCLUDE=项目群,家人群
# 现在构建镜像吗（约 1 GB 下载）：yes / no
#WES_BUILD_IMAGES=yes
# 自己从微信官网下载的 deb 路径；留空表示以后再装
#WES_CLIENT_DEB=/root/WeChatLinux_x86_64.deb
# 装好后马上启动桌面容器：yes / no
#WES_START=yes
