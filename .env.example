# instance create 会生成 instances/<名字>/instance.env，这里说明每一行。手工改时参考 docs/CONFIGURATION.md。
INSTANCE=main
INSTANCE_DIR=/opt/wechat-export-send/instances/main
VNC_WEB_PORT=17900
VNC_BIND=127.0.0.1
PUID=1000
PGID=1000
TZ=Asia/Shanghai
CLIENT_ROOT=/opt/wechat-export-send/client/4.1.13.26
WECHAT_BINARY_SHA256=2749535f299ba67feb8ef80cab898bb0531fa8f376b16f8a72db706811c84132
DESKTOP_IMAGE=wechat-export-send-desktop:1.0.0
DESKTOP_MEM_LIMIT=2g
DESKTOP_CPUS=1.5
# 下面三行只有用 compose.proxy.yaml 才需要
# VNC_PROXY_BIND=内网地址
# VNC_PROXY_PORT=17901
# VNC_PROXY_HTPASSWD=/opt/wechat-export-send/instances/main/htpasswd
