#!/bin/sh /etc/rc.common
# OpenWrt 上开机拉起桌面容器。复制成 /etc/init.d/wechat-export-send-desktop-<实例>，改下面两行。
USE_PROCD=1
START=99
STOP=7
APP=/opt/wechat-export-send
INSTANCE=main

start_service() {
    procd_open_instance
    procd_set_param command "$APP/bin/wechat-export-send" instance up "$INSTANCE"
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

stop_service() {
    "$APP/bin/wechat-export-send" instance down "$INSTANCE"
}
